# ============================================================================
# DSH Remote · 群体服务版（A 模式）环境变量模板
#
# 用法（在 server/ 下）：
#   cp .env.group.example .env.group
#   # 编辑 .env.group（端口/镜像/日志/可选 admin token）
#   DOCKER_DEFAULT_PLATFORM=linux/amd64 docker compose --env-file .env.group \
#     -f docker-compose.group.yml up -d --build
#
# 注意：域名、边缘通配证书路径、签名密钥、admin token 文件、mobilePort 等
# 都在 data/config/relay.json 里（模板：group/relay.group.example.json）；
# 本文件只放 compose / 容器层变量，不要和 classic 的 .env 混用。
# ============================================================================

# 镜像名（本机构建，或 docker load 离线包后使用）
DSH_RELAY_IMAGE=dsh-remote-relay:0.2.1-group

# 监听地址：直连公网用 0.0.0.0；宿主机 nginx 前置时改 127.0.0.1（由 nginx L4 转发）。
RELAY_GROUP_EDGE_BIND=0.0.0.0
RELAY_GROUP_CONTROL_BIND=0.0.0.0
# HTTP（/healthz）默认只绑回环
RELAY_GROUP_HTTP_BIND=127.0.0.1

# 【手机访问】relay 容器在宿主机上的绑定端口（nginx 前置时只给本机 nginx 用，不直接对公网）。
# 注意：同机已有 classic relay 时，classic 默认占用 1443/18443，group 请改成其它端口
#       （如 16443/18444；注册 API/后台默认 19443/19444，不冲突），否则 compose 宿主端口冲突；
#       nginx 合并模板里对应改 upstream。
RELAY_GROUP_EDGE_PORT_HOST=1443

# 【手机实际访问端口】写进配对二维码/主机注册响应的 mobilePort，必须等于「公网入口端口」：
#   - 直连（无 nginx）：= RELAY_GROUP_EDGE_PORT_HOST（默认 1443）
#   - 有 nginx 前置（推荐生产）：= nginx 的 listen 端口（通常 443）
# 常见错误：nginx 监听 443 转发到 127.0.0.1:1443，却把这里留成 1443 —— 手机会去连 1443（公网不可达）。
RELAY_GROUP_MOBILE_PORT=443

# 【控制面】主机隧道（WSS）+ 自助注册（/__group/register）+ 部署方后台（/__admin）。
# 这个端口**必须对主机公网可达**（主机从各自网络连 WSS 隧道，和单机版 8443 一样），
# 并不存在「不对群成员暴露」——主机运营者就是群成员，他们必须能连。
# 真正的运营面是同一个端口上的 /__admin：靠 admin token + 失败限速保护；
# 想再收紧的话，用 nginx 前置 basic auth/IP 白名单，或给后台单独域名反代。
# admin token 只给部署方，不要发给群成员。
RELAY_GROUP_CONTROL_PORT_HOST=18443

# 【注册 API / 部署方后台】与控制面 WSS 分开（职责分离）：
#   主机插件「服务地址」填 https://<relayDomain>:19443（= 注册 API 公网端口）
#   后台只绑回环（默认 127.0.0.1:19444），经 nginx/basic auth 或 SSH 隧道访问
RELAY_GROUP_API_PORT=9443            # 容器内注册 API 监听端口
RELAY_GROUP_API_PORT_HOST=19443      # 宿主映射（公网，主机注册用）
RELAY_GROUP_API_GATEWAY_BIND=0.0.0.0
RELAY_GROUP_ADMIN_PORT=9444          # 容器内后台监听端口
RELAY_GROUP_ADMIN_PORT_HOST=19444    # 宿主映射（默认只回环）
RELAY_GROUP_ADMIN_GATEWAY_BIND=127.0.0.1

# 注册响应里下发给主机的控制面 WSS 公网端口：
#   nginx 前置 → 8443；直连映射控制面 → RELAY_GROUP_CONTROL_PORT_HOST（如 18443）
RELAY_GROUP_PUBLIC_CONTROL_PORT=8443

# 【HTTP】仅 /healthz 与 301，不承载业务
RELAY_GROUP_HTTP_PORT_HOST=18080

# 日志级别：debug | info | warn | error | silent
RELAY_LOG_LEVEL=info

# 可选：显式指定部署方后台 admin token。
# **强烈建议留空**，让容器首次启动自动生成 0600 文件 data/admin-token；
# 查看：docker exec dsh-relay-group node packages/relay/bin/relay.js admin-token --config /data/config/relay.json
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 注意：该 token 只用于后台登录，与主机隧道 / 设备会话 token 无关，不要发给群成员。
RELAY_ADMIN_TOKEN=

# 容器运行 UID/GID（镜像内 relay 用户默认 100:101）。
# data/ 目录必须归这个 UID:GID 所有：
#   chown -R 100:101 data
RELAY_UID=100
RELAY_GID=101

# 构建平台提示：Apple Silicon 构建 x86_64 服务器镜像时设置（shell 变量，不属于 compose 文件）：
# DOCKER_DEFAULT_PLATFORM=linux/amd64

# ============================================================================
# DSH Remote · 群体服务版（A 模式）环境变量模板
#
# 用法（server/ 目录下）：
#   cp .env.group.example .env.group
#   DOCKER_DEFAULT_PLATFORM=linux/amd64 docker compose --env-file .env.group \
#     -f docker-compose.group.yml up -d --build
#   生产服务器上可改名为标准 docker-compose.yml + .env（见 README §10）。
#
# ⚠️ docker compose 默认只读 `.env`，不会自动读 `.env.group`：
#    文件叫 .env.group 时必须带 --env-file .env.group；改名为 .env 可省略。
#
# ⚠️ 这台机器已经跑了 classic（单机版）？
#    classic 的 nginx 占 443/8443、relay 容器占 1443/18443/18080，group 要把下面几行
#    改成「让开后的端口」（直接改本文件即可，不用另建模板）：
#      RELAY_GROUP_EDGE_HOST_PORT=16443
#      RELAY_GROUP_CONTROL_HOST_PORT=18444
#      RELAY_GROUP_HEALTH_HOST_PORT=18081
#      RELAY_GROUP_EDGE_BIND=127.0.0.1
#      RELAY_GROUP_CONTROL_BIND=127.0.0.1
#    ★ 端口 MOBILE=443 / PUBLIC_CONTROL=8443 不变（仍走 nginx 的 443/8443，SNI 分流）。
#
# ★ = 需要让外部访问（放行防火墙/安全组，或由 nginx 转发）；
#     其余端口只在本机/容器之间用，**不要**对外放行。
#
# ── 端口速查（两种形态二选一）───────────────────────────────────────────────
#
#   变量                              直连（无 nginx）          nginx 前置（推荐生产）
#   ────────────────────────────────  ──────────────────────    ──────────────────────────────
#   RELAY_GROUP_MOBILE_PORT      ★   1443（手机直连）          443（= nginx listen）
#   RELAY_GROUP_PUBLIC_CONTROL_PORT ★ 18443（主机直连 WSS）     8443（= nginx listen 8443）
#   RELAY_GROUP_API_HOST_PORT    ★   19443                    19443
#   RELAY_GROUP_ADMIN_HOST_PORT      19444（只听回环）          19444（只听回环；SSH/nginx vhost）
#   RELAY_GROUP_EDGE_HOST_PORT       1443（bind 0.0.0.0）       1443（bind 127.0.0.1，给 nginx）
#   RELAY_GROUP_CONTROL_HOST_PORT    18443（bind 0.0.0.0）      18443（bind 127.0.0.1，给 nginx）
#   RELAY_GROUP_HEALTH_HOST_PORT ✗   18080（只听回环）          18080（同机 classic 时改成 18081）
#
# 同机已有 classic 时（它默认占 1443/18443/18080）：EDGE/CONTROL/HEALTH 改成 16443/18444/18081；
# 直连形态下 MOBILE / PUBLIC_CONTROL 也要同步改成 16443/18444（见第 3.5 节）。
#
# 容器内部固定端口（不需要、也不应该在这里改）：
#   edge=443 / 控制面 WSS=8443 / 注册 API=9443 / 后台=9444 / healthz=80
# ============================================================================

# ── 0) 域名与证书（首次启动据此自动生成 data/config/relay.json）───────────────

# relay 域名：控制面证书的 CN/SAN；主机子域 = <hostId>.<RELAY_DOMAIN>
RELAY_DOMAIN=relay.example.com

# 证书默认放在 data/certs 下即可（不用设置变量）：
#   控制面：data/certs/<RELAY_DOMAIN>/{fullchain.pem,privkey.pem}
#   边缘通配：data/certs/wildcard/{fullchain.pem,privkey.pem}
# 路径不同时再取消注释（容器内路径）：
# RELAY_TLS_CERT_FILE=/data/certs/relay.example.com/fullchain.pem
# RELAY_TLS_KEY_FILE=/data/certs/relay.example.com/privkey.pem
# RELAY_GROUP_EDGE_CERT_FILE=/data/certs/wildcard/fullchain.pem
# RELAY_GROUP_EDGE_KEY_FILE=/data/certs/wildcard/privkey.pem
#
# 首次启动会自动生成 data/config/relay.json（已存在则不会覆盖）；高级项可直接编辑它。

# ── 1) ★ 公网入口：必须放行 / 由 nginx 转发 ───────────────────────────────────

# 手机访问端口（写进配对二维码）。
#   nginx 前置：= nginx 的 listen 端口（通常 443）
#   直连：      = RELAY_GROUP_EDGE_HOST_PORT
#               · 全新服务器默认 1443
#               · 同机已有 classic → 1443 已被占用，EDGE_HOST_PORT 必须是 16443，这里也跟着 16443
#                 （如果 group 前面有 nginx，这里仍然是 nginx 的 listen 端口 443）
RELAY_GROUP_MOBILE_PORT=443

# 主机隧道（WSS）的公网端口：注册响应里 controlUrl 下发的端口。
#   nginx 前置：= nginx listen 的 8443
#   直连：      = RELAY_GROUP_CONTROL_HOST_PORT
#               · 全新服务器默认 18443
#               · 同机已有 classic → CONTROL_HOST_PORT 改 18444 时，这里也要 18444
RELAY_GROUP_PUBLIC_CONTROL_PORT=8443

# 注册 API 公网端口：主机插件「服务地址」填 https://<relayDomain>:19443
RELAY_GROUP_API_HOST_PORT=19443
# 监听地址：直连公网 = 0.0.0.0；用 nginx 反代 = 127.0.0.1（只让本机 nginx 访问）
RELAY_GROUP_API_HOST_BIND=0.0.0.0

# ── 2) 仅本机：不要放行、不要转发 ─────────────────────────────────────────────

# 部署方后台：默认只绑 127.0.0.1，用 SSH 隧道或 nginx 反代访问
RELAY_GROUP_ADMIN_HOST_PORT=19444

# ── 3) 内部端口与绑定：一般不用改 ─────────────────────────────────────────────
#    用 nginx 前置时：把下面两个 BIND 改成 127.0.0.1（只给本机 nginx 转发）

# relay 边缘的宿主机端口（容器内 443 的映射）
RELAY_GROUP_EDGE_HOST_PORT=1444
# 控制面 WSS 的宿主机端口（容器内 8443 的映射）
RELAY_GROUP_CONTROL_HOST_PORT=18443
# 直连：0.0.0.0；有 nginx 前置：127.0.0.1
RELAY_GROUP_EDGE_BIND=0.0.0.0
RELAY_GROUP_CONTROL_BIND=0.0.0.0

# /healthz 的宿主机端口（只绑 127.0.0.1，不对外，不需要转发）。
# 同机已有 classic relay（它默认也占 18080）时，改成 18081 之类的其它端口即可。
RELAY_GROUP_HEALTH_HOST_PORT=18080

# ── 3.5) 同机已有 classic（单机版）时：group 要让开的端口 ─────────────────────
# classic 默认占用 1443（数据）/18443（控制）/18080（healthz），group 改成：
#   RELAY_GROUP_EDGE_HOST_PORT=16443
#   RELAY_GROUP_CONTROL_HOST_PORT=18444
#   RELAY_GROUP_HEALTH_HOST_PORT=18081
#
# 再按 group 自己的形态改 ★ 端口：
#   有 nginx 前置（推荐）：★ 端口保持 443 / 8443，bind 改回环
#     RELAY_GROUP_MOBILE_PORT=443
#     RELAY_GROUP_PUBLIC_CONTROL_PORT=8443
#     RELAY_GROUP_EDGE_BIND=127.0.0.1
#     RELAY_GROUP_CONTROL_BIND=127.0.0.1
#   直连（无 nginx）：★ 端口必须跟着内部端口走，否则手机/主机会连到 classic 的 1443/18443
#     RELAY_GROUP_MOBILE_PORT=16443
#     RELAY_GROUP_PUBLIC_CONTROL_PORT=18444
#     RELAY_GROUP_EDGE_BIND=0.0.0.0
#     RELAY_GROUP_CONTROL_BIND=0.0.0.0

# ── 4) 镜像 / 日志 / 凭据 / 权限 ──────────────────────────────────────────────

DSH_RELAY_IMAGE=dsh-remote-relay:0.2.5-group
RELAY_LOG_LEVEL=info

# 可选：显式指定部署方后台 admin token。
# 建议留空：首次启动自动生成到 data/admin-token（0600），查看方式见 README。
RELAY_ADMIN_TOKEN=

# 容器运行 UID/GID（data/ 需归它所有：chown -R 100:101 data）
RELAY_UID=100
RELAY_GID=101

# Apple Silicon 构建 x86_64 镜像时用（shell 变量，不属于 compose 文件）：
# DOCKER_DEFAULT_PLATFORM=linux/amd64

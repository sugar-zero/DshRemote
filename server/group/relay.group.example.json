{
  "domain": "relay.example.com",
  "controlPort": 8443,
  "httpPort": 80,
  "listenHost": "0.0.0.0",
  "tls": {
    "certFile": "/data/certs/relay.example.com/fullchain.pem",
    "keyFile": "/data/certs/relay.example.com/privkey.pem"
  },
  "logLevel": "info",
  "group": {
    "file": "/data/group.json",
    "mobilePort": 443,
    "maxHosts": 200,
    "apiPort": 9443,
    "apiBind": "0.0.0.0",
    "adminPort": 9444,
    "adminBind": "127.0.0.1",
    "publicControlPort": 8443,
    "registration": {
      "enabled": true,
      "maxAttemptsPerMinutePerIp": 10,
      "maxAttemptsPerMinute": 120,
      "bodyLimitBytes": 8192
    },
    "edge": {
      "enabled": true,
      "port": 443,
      "tls": {
        "certFile": "/data/certs/wildcard/fullchain.pem",
        "keyFile": "/data/certs/wildcard/privkey.pem"
      },
      "allowUnauthenticated": false
    },
    "auth": {
      "tokenTtlMs": 900000,
      "challengeTtlMs": 120000,
      "maxAttemptsPerMinutePerIp": 30,
      "signingKeyFile": "/data/signing-key.pem"
    },
    "adminTokenFile": "/data/admin-token",
    "push": {
      "enabled": false,
      "mode": "self",
      "content": "generic",
      "cooldownSeconds": 30,
      "self": {
        "keyFile": "/data/apns/AuthKey_<KEY_ID>.p8",
        "keyId": "<KEY_ID>",
        "teamId": "<TEAM_ID>",
        "topic": "<BUNDLE_ID>",
        "environment": "auto"
      }
    }
  }
}

# 复制为 .env 后修改：
#   cp .env.example .env
RELAY_DOMAIN=relay.example.com

# 主机 ID（必须与主机插件里的 hostId 一致）
RELAY_HOST_ID=h_ab12cd34

# 可选：显式指定 host token；留空则容器首次启动自动生成随机 token
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 注意：这个值要和主机插件「中继主机令牌」完全一致。
RELAY_HOST_TOKEN=

RELAY_LOG_LEVEL=info

# relay 只绑定到回环地址；宿主机 nginx 转发到这里
# nginx 模式：relay 只绑定本机回环，由 nginx 转发
RELAY_DATA_PORT_HOST=1443
RELAY_CONTROL_PORT_HOST=18443
RELAY_HTTP_PORT_HOST=18080

# 直连模式（docker-compose.direct.yml）：公网映射端口
# App 通过二维码使用 RELAY_PUBLIC_DATA_PORT；主机插件 publicPort 要一致。
RELAY_PUBLIC_DATA_PORT=1443
RELAY_PUBLIC_CONTROL_PORT=8443

# 可选镜像名
DSH_RELAY_IMAGE=dsh-remote-relay:0.1.0
NGINX_IMAGE=nginx:1.27-alpine

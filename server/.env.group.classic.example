# ============================================================================
# DSH Remote · 群体服务版（A 模式）——【同机已有 classic（单机版）】专用模板
#
# 适用：这台服务器已经跑了 main 的 classic relay + nginx L4：
#   - nginx 已监听 443/8443（按 SNI 转发给 classic relay）；
#   - classic relay 已占用宿主机 1443（数据面）/18443（控制面）/18080（healthz）。
# 因此 group 的端口必须全部让开，nginx 用合并版 stream 按 SNI 分流：
#   server/nginx/host-nginx-stream.combined.conf
#
# 用法（server/ 下）：
#   cp .env.group.classic.example .env.group
#   docker compose --env-file .env.group -f docker-compose.group.yml up -d --build
# ============================================================================

# ── 0) 域名与证书 ─────────────────────────────────────────────────────────────
# ⚠️ group 必须用自己的 relay 域名（不能和 classic 相同；通配证书也不同）。
#    主机子域 = <hostId>.<RELAY_DOMAIN>
RELAY_DOMAIN=relay.example.com

# 证书默认位置（不用设变量）：
#   控制面：data/certs/<RELAY_DOMAIN>/{fullchain.pem,privkey.pem}
#   边缘通配：data/certs/wildcard/{fullchain.pem,privkey.pem}
# 路径不同时取消注释：
# RELAY_TLS_CERT_FILE=/data/certs/relay.example.com/fullchain.pem
# RELAY_TLS_KEY_FILE=/data/certs/relay.example.com/privkey.pem
# RELAY_GROUP_EDGE_CERT_FILE=/data/certs/wildcard/fullchain.pem
# RELAY_GROUP_EDGE_KEY_FILE=/data/certs/wildcard/privkey.pem

# ── 1) ★ 公网入口：仍由 nginx 的 443/8443 承接 ────────────────────────────────
# 手机访问端口 = nginx listen 的 443（不是内部 16443）
RELAY_GROUP_MOBILE_PORT=443
# 主机 WSS 公网端口 = nginx listen 的 8443（合并 stream 按 SNI 分流到 group 18444）
RELAY_GROUP_PUBLIC_CONTROL_PORT=8443
# 注册 API：直接用 relay 自己的公网端口（与 classic 不冲突）
RELAY_GROUP_API_HOST_PORT=19443
# 部署方后台：只听回环（SSH 隧道 / nginx admin vhost）
RELAY_GROUP_ADMIN_HOST_PORT=19444

# ── 2) 内部端口：避开 classic 已占用的 1443/18443/18080 ───────────────────────
# relay 边缘（容器 443 的宿主机映射）→ 16443（不能用 1443）
RELAY_GROUP_EDGE_HOST_PORT=16443
# 控制面 WSS（容器 8443 的宿主机映射）→ 18444（不能用 18443）
RELAY_GROUP_CONTROL_HOST_PORT=18444
# /healthz 宿主端口 → 18081（不能用 18080）
RELAY_GROUP_HEALTH_HOST_PORT=18081
# 有 nginx 前置：只绑回环，由 nginx L4 转发
RELAY_GROUP_EDGE_BIND=127.0.0.1
RELAY_GROUP_CONTROL_BIND=127.0.0.1
# 注册 API 若也走 nginx 反代/转发，改为 127.0.0.1（默认直连公网）
RELAY_GROUP_API_HOST_BIND=0.0.0.0

# ── 3) 镜像 / 日志 / 凭据 / 权限 ──────────────────────────────────────────────
DSH_RELAY_IMAGE=dsh-remote-relay:0.2.3-group
RELAY_LOG_LEVEL=info
# 可选：显式 admin token（建议留空，首次启动自动生成 data/admin-token 0600）
RELAY_ADMIN_TOKEN=
RELAY_UID=100
RELAY_GID=101

# Apple Silicon 构建 x86_64 镜像时用（shell 变量）：
# DOCKER_DEFAULT_PLATFORM=linux/amd64

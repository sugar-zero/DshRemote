# ============================================================================
# DSH Remote · 官方推送 hub 环境变量模板（push-hub 0.3.0 = R2-only）
#
# 官方推送 hub 由项目所有者部署/运营：
#   - 官方 App 用设备密钥向 hub 登记（/v1/enroll*）换 per-device credential，
#     主机拿 credential 直连 /v1/push；官方推送**不依赖**部署方 relay 配置；
#   - hub 不识别 relay、不接受 relay 转发（legacy O1 已删除）；
#   - hub 只发固定通用文案，用**官方 App 的 APNs Auth Key** 发送，不含会话内容。
#
# 用法（server/ 目录下）：
#   cp .env.push-hub.example .env.push-hub
#   # 1) 把官方 APNs .p8 放到宿主机某个目录（不要放进仓库），填 HUB_APNS_KEY_DIR
#   # 2) 填 HUB_APNS_KEY_ID / HUB_APNS_TEAM_ID / HUB_APNS_TOPIC
#   # 3) 填 HUB_PUBLIC_URL（= 官方 App 打包内置的 hub 公网地址，同时也是 credential 的 aud）
#   # 4) 按需改 HUB_HOST_PORT；然后用 nginx 终止 TLS（见 nginx/push-hub-http.conf）
#   DOCKER_DEFAULT_PLATFORM=linux/amd64 docker compose --env-file .env.push-hub \
#     -f docker-compose.push-hub.yml up -d --build
#
# ⚠️ docker compose 默认只读 `.env`，不会自动读 `.env.push-hub`：
#    文件叫 .env.push-hub 时必须带 --env-file .env.push-hub；改名为 .env 可省略。
# ⚠️ 本文件含**路径与部署参数**，不要提交仓库；真实 .p8 永远只放服务器。
#
# 拓扑（生产推荐，只有 nginx 对公网）：
#   官方 App ──HTTPS──► nginx:443 (TLS 终止) ──HTTP──► 127.0.0.1:19445 (hub：/v1/enroll*)
#   主机(host-plugin) ──HTTPS──► 同上 /v1/push（Bearer device credential）
#   hub 只发布到宿主回环；公网域名示例：push.example.com
# ============================================================================

# ── 0) 官方 APNs Auth Key（必需，只读挂载）───────────────────────────────────
#
# 宿主机上存放 .p8 的目录（**不要**放进仓库；建议 chmod 700 目录 / 600 文件）。
# compose 会把它只读挂载到容器内 /data/apns。
# ⚠️ 容器以 HUB_UID=100（默认）非 root 运行：.p8 必须能被该 UID 读取，
#    否则 /healthz 会显示 apns.configured=false。做法二选一：
#      chown 100:101 /path/to/apns-keys /path/to/apns-keys/AuthKey_<KEY_ID>.p8
#      或目录 755 + 文件 644（仅当这台机器没有其他敏感文件时）
HUB_APNS_KEY_DIR=/path/to/apns-keys
#
# 容器内路径：/data/apns/ 下真实文件名（Apple 下载时就是 AuthKey_<KEY_ID>.p8）。
HUB_APNS_KEY_FILE=/data/apns/AuthKey_<KEY_ID>.p8
# Apple Developer 后台 → Keys 里的 Key ID（10 位字母数字）
HUB_APNS_KEY_ID=<KEY_ID>
# Apple Developer Team ID（10 位字母数字）
HUB_APNS_TEAM_ID=<TEAM_ID>
# 官方 App 的 bundle id（推送 topic；必须与 App 签名一致，否则 BadDeviceToken/DeviceTokenNotForTopic）
# 同时是 /v1/enroll 允许的唯一 bundleId。
HUB_APNS_TOPIC=<OFFICIAL_BUNDLE_ID>

# ── 1) R2：设备直连（官方 App ↔ hub 设备登记 / credential）────────────────────
#
# ★ HUB_PUBLIC_URL 必填：官方 App 打包时内置的 hub 公网地址（nginx 域名，https）。
#   - 它是 credential 的 aud：hub 签发和校验时都用同一字符串，改了要重启 hub；
#   - 只能 https、不能带 query/fragment/userinfo；尾斜杠会被去掉；
#   - 不设置时 hub 仍能启动，但设备直连/enroll 全部禁用：
#     /healthz 显示 credential.enabled=false、enroll.enabled=false；
#     /v1/enroll* 返回 503 enroll_disabled，device credential 推送返回 503 push_unavailable。
HUB_PUBLIC_URL=https://push.example.com
#
# Ed25519 签名 key（PKCS#8 PEM，0600）。**不存在时首次启动自动生成**到 /data 卷，
# 之后保持不变（kid 稳定）。不要删：删了已签发的 credential 全部失效（设备会重新登记）。
# 想轮换：停 hub → 备份旧 key → 删文件 → 启动（新 key 生效，旧 credential 自然失效）。
HUB_SIGNING_KEY_FILE=/data/push-hub-signing-key.pem
# credential 有效期（天，默认 30；App 在剩余 <24h 时自动重新登记）
HUB_CREDENTIAL_TTL_DAYS=30
# 是否启用 /v1/enroll*（默认 true；维护/紧急止损时可设 false）
HUB_ENROLL_ENABLED=true
# enroll challenge 的 nonce TTL（秒，默认 120；契约 §4.1）
HUB_ENROLL_CHALLENGE_TTL_SECONDS=120

# ── 2) 网络与端口 ─────────────────────────────────────────────────────────────
#
# ONLY 127.0.0.1：端口只发布到宿主回环，对外一律走 nginx TLS 反代。
# 同机 19445 被占用时改这里（同时改 nginx/push-hub-http.conf 里的 proxy_pass 端口）。
HUB_HOST_PORT=19445
#
# 容器内固定监听（compose 已设置，不要改）：HUB_LISTEN_HOST=0.0.0.0 / HUB_PORT=9445
# 宿主机发布：127.0.0.1:${HUB_HOST_PORT} → 容器 9445

# ── 3) 配额（一般不用改）───────────────────────────────────────────────────────
#
# 每请求最多 token 数（契约默认 20）
HUB_MAX_TOKENS_PER_REQUEST=20

# ── R2 push 配额（默认值 = docs/group-push-load-evaluation.zh.md §4；超限 429 + Retry-After）
# 每设备 token：每分钟 / 每天
HUB_PUSH_PER_MINUTE_PER_TOKEN=6
HUB_PUSH_PER_DAY_PER_TOKEN=120
# 每 credential（同一设备同一 credential 实例）
HUB_PUSH_PER_MINUTE_PER_CREDENTIAL=6
# 每 host（同一主机多设备共享；防止单主机刷）
HUB_PUSH_PER_MINUTE_PER_HOST=30
# 每来源 IP / 全局兜底（hub 在 nginx 后面时来源 IP 都是回环，
# 真正的 per-client-IP 限速在 nginx：见 nginx/push-hub-http.conf 的 limit_req_zone）
HUB_PUSH_PER_MINUTE_PER_IP=60
HUB_PUSH_PER_MINUTE_GLOBAL=120

# ── R2 enroll 配额（防批量假登记）
# 每 IP / 每小时
HUB_ENROLL_PER_HOUR_PER_IP=20
# 每设备（APNs token 的 hash）/ 每小时
HUB_ENROLL_PER_HOUR_PER_DEVICE=5
# challenge / 每小时 / 每 IP
HUB_CHALLENGE_PER_HOUR_PER_IP=60

# 日志级别：debug | info | warn | error | silent
HUB_LOG_LEVEL=info

# ── 4) 可选：hub 自己跑 HTTPS（一般不用，交给 nginx）──────────────────────────
#
# 默认由 nginx 终止 TLS，hub 只跑 HTTP（容器内回环 + 宿主回环发布）。
# 如果不用 nginx、要让 hub 直接对公网提供 HTTPS，再取消注释（容器内路径）：
# HUB_TLS_CERT_FILE=/data/certs/fullchain.pem
# HUB_TLS_KEY_FILE=/data/certs/privkey.pem
#
# 可选：改用 hub.json 配置文件（挂载到容器 /data/config/hub.json）；不设则纯环境变量运行。
# 配置文件里的相对路径按该文件目录解析；env 覆盖配置文件。
# HUB_CONFIG=/data/config/hub.json

# ── 5) 排障 ───────────────────────────────────────────────────────────────────
#
#   curl -fsS http://127.0.0.1:${HUB_HOST_PORT}/healthz
#     → {"ok":true,
#        "apns":{"configured":true,"topic":"<OFFICIAL_BUNDLE_ID>"},
#        "credential":{"enabled":true,"ttlDays":7},
#        "enroll":{"enabled":true},
#        "limits":{...}}
#       apns.configured=false         ：APNs key 路径/权限不对（看 hub 日志；日志不会打印密钥）
#       credential.enabled=false      ：HUB_PUBLIC_URL 未设置 / APNs topic 缺失 / 签名 key 不可用
#       enroll.enabled=false          ：同上，或 HUB_ENROLL_ENABLED=false
#
#   docker logs --tail 100 dsh-push-hub
#     → 日志只有模式 / 条数 / 结果；**不会**出现设备 token、credential、私钥。
#
#   常见原因：
#     - 401 invalid_credential / credential_expired：credential 被改/过期；
#       App 应重新走 /v1/enroll；检查 hub 的签名 key 是否被换过
#     - 401 token_mismatch（R2）：主机上报的 APNs token 与 credential 绑定的不一致（重新登记）
#     - 400 unsupported_bundle_id：bundleId 不是 HUB_APNS_TOPIC（官方 App 与 hub 配置不一致）
#     - 400 challenge_expired / challenge_used：challenge 超过 120s 或已用过 → 重新申请
#     - 400 invalid_signature：设备 PoP 签名失败（App 设备密钥/消息字节不一致）
#     - 429 rate_limited：命中某层配额；看 message 里的层级（token/credential/host/IP/全局），
#       等 Retry-After 秒或按需调大上面配额
#     - 400 invalid_request：发了 title/body/sessionId 等官方通道不允许的字段
#     - 503 push_unavailable / enroll_disabled：APNs 未配置 / R2 未启用（看 healthz）

{
  "name": "dsh-remote-service",
  "version": "0.2.8",
  "type": "module",
  "description": "DSH 群体服务版主机插件：自助注册部署方 relay、出站隧道、loopback 明文反代、token 验签、群体配对与管理 API",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}

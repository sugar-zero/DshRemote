{
  "name": "dsh-remote-app",
  "version": "0.1.5",
  "main": "index.ts",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "DSH Remote — Expo/React Native shell for accessing a DSH host over a blind relay with mTLS device certificates",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "doctor": "expo-doctor",
    "check:native": "node scripts/check-native-sources.mjs",
    "check:shell": "node scripts/check-injected-shell.mjs",
    "check:ios-env": "bash scripts/check-ios-env.sh",
    "check:android-env": "bash scripts/check-android-env.sh"
  },
  "dependencies": {
    "expo": "~58.0.14",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.10",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.5",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
